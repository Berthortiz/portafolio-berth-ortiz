---
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import logo from "../assets/img/logo-berth.svg";
import Footer from "../sections/Footer.astro";
import "../css/style.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: string;
}

const {
	title = "Berth Ortiz",
	description = "Desarrollo de Páginas Web para Negocios y Empresas | Berth Ortiz",
	image,
	canonical,
	type,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href={logo.src} />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			description={description}
			image={image}
			canonical={canonical}
			type={type}
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<script></script>
<style is:global>
	:root {
		--color-brand: #008cff; /* color principal de la marca */
		--color-brand-two: #03cff3;
		--color-brand-secundary: #e7effa; /* tarjetas, secciones */
		--color-text-primary: #a5b4cb; /* texto principal */
		--color-secundary: #dce8f5;
		--color-text-black: #09111f;

		--color-bg: #080e1c; /* fondo */
	}

	html,
	body {
		margin: 0;
		width: 100%;
		background-color: var(--color-bg);
		/* min-height: 200vh; */
		font-family: "Inter", sans-serif;
		font-optical-sizing: auto;
		transition: width 1s ease;

		/* scrollbar-gutter: stable; */
		/* overflow: hidden; */
	}
	h1,
	h2,
	h3,
	h4 {
		font-family: "Inter", sans-serif;
		font-optical-sizing: auto;
		font-style: normal;
		color: #ffffff;
	}

	.gradiente-title-g {
		color: var(--color-brand);
		background-image: linear-gradient(
			to right,
			var(--color-brand),
			var(--color-brand-two)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
