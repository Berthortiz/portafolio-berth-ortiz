---
import { Icon } from "astro-icon/components";

const steps = [
    {
        icon: "communication",
        title: "Diagnóstico",
        description:
            "Conocemos tu negocio, tu público y tus objetivos para detectar qué necesita realmente tu página web.",
    },
    {
        icon: "brush",
        title: "Estrategia y diseño",
        description:
            "Definimos la estructura, los textos y el diseño visual alineados con tu marca antes de programar.",
    },
    {
        icon: "code-icon",
        title: "Desarrollo",
        description:
            "Construimos tu web con código limpio, optimizada para velocidad y buscadores, y adaptada a todos los dispositivos.",
    },
    {
        icon: "web-icon",
        title: "Publicación y acompañamiento",
        description:
            "Publicamos tu sitio, te enseñamos a gestionarlo y te acompañamos con el soporte y las mejoras que necesites.",
    },
];
---

<script is:inline>
    const procesoReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if ("IntersectionObserver" in window && !procesoReducedMotion) {
        document.documentElement.classList.add("proceso-js");
    }
</script>

<section
    id="proceso"
    class="relative px-4 py-16 sm:px-6 sm:py-20 lg:py-[100px]"
>
    <div class="mx-auto max-w-7xl">
        <header class="mx-auto mb-12 max-w-2xl text-center sm:mb-16 lg:mb-[70px]">
            <span class="mb-4 block text-sm font-semibold text-brand">
                Cómo trabajamos
            </span>
            <h2
                class="mb-4 text-3xl font-extrabold leading-[1.15] tracking-[-0.02em] text-white sm:text-4xl lg:text-5xl"
            >
                De la idea a una web que vende
            </h2>
            <p
                class="mx-auto max-w-[580px] text-base leading-[1.6] text-(--color-text-primary) sm:text-[1.05rem]"
            >
                Un proceso claro y sin vueltas, para que tu web esté online
                rápido y enfocada en atraer clientes.
            </p>
        </header>

        <ol
            role="list"
            class="proceso-grid relative grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4"
        >
            {
                steps.map((step, index) => (
                    <li
                        class="proceso-card relative z-20 flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:p-8"
                        style={`--proceso-delay: ${index * 0.12}s`}
                    >
                        <span
                            class="mb-6 inline-flex h-9 w-9 items-center justify-center rounded-[10px] bg-(--color-brand) text-white"
                        >
                            <Icon name={step.icon} size={18} aria-hidden="true" />
                        </span>
                        <h3 class="mb-2.5 text-lg font-bold tracking-[-0.01em] text-white sm:text-[1.2rem]">
                            {step.title}
                        </h3>
                        <p class="m-0 text-[0.92rem] leading-[1.55] text-(--color-text-primary)">
                            {step.description}
                        </p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<script>
    const processCards =
        document.querySelectorAll<HTMLElement>(".proceso-card");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (
        processCards.length &&
        !reduceMotion &&
        "IntersectionObserver" in window
    ) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;

                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                });
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );

        processCards.forEach((card) => observer.observe(card));
    } else {
        processCards.forEach((card) => card.classList.add("is-visible"));
    }
</script>

<style>
    .proceso-card {
        transition:
            opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1)
                var(--proceso-delay, 0s),
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)
                var(--proceso-delay, 0s),
            border-color 0.3s ease,
            background-color 0.3s ease;
    }

    .proceso-card:hover {
        border-color: rgba(0, 140, 255, 0.45);
        background-color: rgba(255, 255, 255, 0.04);
    }

    :global(html.proceso-js) .proceso-card {
        opacity: 0;
        transform: translateY(25px);
    }

    :global(html.proceso-js) .proceso-card.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* El orden entre pasos lo da la posición en el <ol>; nada de líneas conectoras. */

    @media (prefers-reduced-motion: reduce) {
        .proceso-card,
        :global(html.proceso-js) .proceso-card {
            transition: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
