---
import { Icon } from "astro-icon/components";
import olivaresImg from "../assets/img/olivares.png";
import mariaImg from "../assets/img/maria.png";
import fgcImg from "../assets/img/FGC.png";

const testimonials = [
  {
    description:
      "¡Gran experiencia de trabajo! Creó una página web moderna, limpia y adaptada a celulares de forma súper rápida. El soporte y la atención al detalle fueron de diez.",
    name: "Jeaustin Olivares",
    job: "Especialista en Marketing ",
    srcImg: olivaresImg,
  },
  {
    description:
      "Como realtor, mi página web es mi carta de presentación. El diseño es sumamente elegante, moderno y adaptado perfectamente a celulares, El proceso de trabajo fue sumamente profesional.",
    name: "Maria Martell",
    job: "Agente Inmobiliario",
    srcImg: mariaImg,
  },

  {
    description:
      "Para mi negocio de consultoría, proyectar confianza y seriedad lo es todo. Diseñó una página web impecable que explica mis servicios con claridad y permite que mis prospectos agenden citas.",
    name: "Consulting FGC",
    job: "Asesor financiero",
    srcImg: fgcImg,
  },
];

// --- DATOS ESTRUCTURADOS (SEO) ---
const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Testimonios de Clientes",
  itemListElement: testimonials.map((t, index) => ({
    "@type": "Review",
    position: index + 1,
    itemReviewed: {
      "@type": "Organization",
      name: "Berth Ortiz",
    },
    author: {
      "@type": "Person",
      name: t.name,
    },
    reviewBody: t.description,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<section
  class="lg:max-w-7xl mx-auto h-fit flex md:items-center relative text-gray-600 body-font md:py-20"
>
  <div
    class="w-full flex flex-col md:gap-5 lg:max-w-7xl mx-auto py-10 px-6 md:px-14 items-center"
  >
    <header
      class="w-full flex flex-col md:justify-center md:items-center text-center mb-16 md:mb-0"
    >
      <span class="text-4xl px-3 py-1 text-white font-bold"> Testimonios </span>
      <h2
        class="title-font sm:text-4xl lg:text-5xl text-3xl mb-4 pt-5 font-medium text-(--color-brand-secundary)"
      >
        Vea lo que dicen mis <span class="gradiente-title-g">clientes</span>
      </h2>
      <p
        class="md:max-w-[75ch] mb-1 md:mb-8 leading-relaxed font-normal text-[1.1em] text-(--color-text-primary)"
      >
        He tenido la oportunidad de trabajar con personas y empresas increíbles.
        Más que clientes, los considero compañeros de proyecto, y estas son sus
        palabras sobre el camino que recorrimos juntos.
      </p>
    </header>

    <div class="swiper testimonials-swiper w-full relative h-[310px]">
      <div class="swiper-wrapper">
        {
          testimonials.map((testimonial) => (
            <div class="swiper-slide">
              <figure class="flex bg-[#D5D9DA10] justify-between flex-col gap-4 p-8 rounded-2xl shadow-sm text-left ">
                <div class="flex text-[#4e86ff]" aria-label="5 estrellas">
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                </div>

                <blockquote class="text-(--color-text-primary) ">
                  <p>"{testimonial.description}"</p>
                </blockquote>

                <figcaption class="flex gap-4 mt-3">
                  <div class="w-12 h-12 bg-indigo-200 rounded-full overflow-hidden">
                    <img
                      src={testimonial.srcImg.src}
                      alt={`Foto de ${testimonial.name}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-col">
                    <cite class="font-bold text-(--color-text-primary) not-italic">
                      {testimonial.name}
                    </cite>
                    <span class="text-sm text-gray-500">{testimonial.job}</span>
                  </div>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <div class="swiper-pagination !relative mt-5"></div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Pagination, Autoplay } from "swiper/modules";

  // Estilos necesarios
  import "swiper/css";
  import "swiper/css/pagination";
  const instances = new WeakMap<HTMLElement, Swiper>();

  const initTestimonialSwiper = () => {
    document
      .querySelectorAll<HTMLElement>(".testimonials-swiper")
      .forEach((element) => {
        if (instances.has(element)) return;

        const pagination =
          element.querySelector<HTMLElement>(".swiper-pagination");

        if (!pagination) return;

        const swiper = new Swiper(element, {
          modules: [Pagination, Autoplay],
          slidesPerView: 1,
          spaceBetween: 20,
          loop: true,
          speed: 1200,
          autoplay: {
            delay: 4000,
            disableOnInteraction: false,
          },
          pagination: {
            el: pagination,
            clickable: true,
          },
          breakpoints: {
            640: { slidesPerView: 2 },
            1024: { slidesPerView: 2 },
          },
        });

        instances.set(element, swiper);
      });
  };

  const destroyTestimonialSwiper = () => {
    document
      .querySelectorAll<HTMLElement>(".testimonials-swiper")
      .forEach((element) => {
        instances.get(element)?.destroy(true, true);
        instances.delete(element);
      });
  };

  const resumeTestimonialAutoplay = () => {
    if (document.visibilityState !== "visible") return;

    document
      .querySelectorAll<HTMLElement>(".testimonials-swiper")
      .forEach((element) => {
        const swiper = instances.get(element);
        if (swiper?.autoplay.running && swiper.autoplay.paused) {
          swiper.autoplay.resume();
        }
      });
  };

  initTestimonialSwiper();
  document.addEventListener("astro:page-load", initTestimonialSwiper);
  document.addEventListener("astro:before-swap", destroyTestimonialSwiper);
  document.addEventListener("visibilitychange", resumeTestimonialAutoplay);
  window.addEventListener("focus", resumeTestimonialAutoplay);
  window.addEventListener("pageshow", resumeTestimonialAutoplay);
</script>

<style>
  .swiper-slide {
    /* height: auto; */
    display: flex;
  }

  :global(.swiper-pagination-bullet-active) {
    background-color: var(--color-brand) !important;
    width: 20px;
    border-radius: 5px;
  }

  .swiper-pagination-bullet {
    background: aliceblue !important;
  }
  .swiper-horizontal > .swiper-pagination-bullets,
  .swiper-pagination-horizontal.swiper-pagination-bullets {
    .swiper-pagination-bullet {
      background: rgb(247, 247, 250);
      /* margin: 0 var(--swiper-pagination-bullet-horizontal-gap, 4px); */
    }
  }
</style>
