---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "../components/ButtonPrimary.astro";

const services = [
  {
    icon: "brush-3",
    title: "Diseño profesional",
    description: `Un diseño moderno y alineado a tu identidad que transmite autoridad y credibilidad desde el primer segundo.`,
  },

  {
    icon: "date",
    title: "100 % adaptada a móviles",
    description: `Optimizada para smartphones para ofrecer una experiencia rápida y fluida donde navegan la mayoría de tus clientes. `,
  },
  {
    icon: "shield",
    title: "Protección blindada",
    description: `Implementamos protocolos de seguridad avanzados para proteger tus datos y los de tus clientes, generando confianza en cada transacción.`,
  },
  {
    icon: "tools",
    title: "Soporte y mantenimiento",
    description: `No te dejamos solo. Nos encargamos de que tu sitio esté siempre actualizado, seguro y funcionando al 100% mientras tú te concentras en tu negocio.`,
  },

  {
    icon: "up-arrow",
    title: "SEO",
    description: `Optimizamos elementos básicos de tu sitio, como títulos, descripciones y estructura, para ayudar a los buscadores a entender e indexar mejor tu contenido.`,
  },
  {
    icon: "date",
    title: "Copywriting (textos persuasivos)",
    description: `Creación de textos que comunican tu mensaje con claridad y generan interacción.`,
  },
];
---

<section
  class="w-full h-fit flex md:items-center relative text-gray-600 body-font md:py-20"
>
  <div
    class=`flex flex-col md:flex-row md:gap-10 lg:max-w-7xl xl:gap-2  mx-auto py-10 px-6 md:px-14 items-center relative z-10 `
  >
    <!-- col-1 -->
    <div
      class="self-start md:sticky top-15 xl:top-40 flex flex-col md:w-2/4 md:justify-start pt-20 md:items-start md:text-left mb-16 md:mb-0 items-start text-start"
    >
      <span
        class="btn-item-service text-[.8em]
         px-3 py-1
         rounded-2xl
         font-light"
      >
        • Tu ventana a internet
      </span>
      <h2
        class="title-font text-3xl sm:text-4xl md:text-4xl lg:text-5xl xl:text-6xl mb-4 pt-5 font-bold text-(--color-brand-secundary)"
      >
        Lo que tu página web necesita
      </h2>

      <!-- bg-(--color-brand-secundary) -->
      <p
        class="md:max-w-[58ch] mb-8 leading-relaxed font-normal text-[1em] text-gray-500"
      >
        Transformamos tu visión en una estrategia digital diseñada para dominar
        el mercado. Potenciamos tu presencia online con sitios web de alto
        rendimiento y contenido persuasivo que convierte clics en clientes
        reales.
      </p>
      <ul class="flex flex-col gap-4 text-[1.1em]"></ul>

      <div class="flex justify-center">
        <ButtonPrimary
          title="Ayúdame a crear mi página"
          link="https://wa.link/bqgy6d"
          additionalClass="px-4 py-1.5 text-white"
        />
      </div>
    </div>
    <!-- col-2-->
    <div class="md:w-2/4 grid md:grid-cols-1 grid-cols-1 gap-10">
      {
        services.map((service) => {
          return (
            <section class="flex flex-col gap-2 bg-white/5 text-(--color-brand-secundary) p-8 rounded-2xl">
              <span class=" text-4xl w-13 lg:w-10 xl:w-14 ">
                <Icon
                  name={service.icon === "" ? "star" : `${service.icon}`}
                  size={50}
                  class="text-(--color-brand-secundary) w-full h-auto"
                />
              </span>
              <h2
                id="title-card-sticky"
                class=" text-2xl font-medium lg:text-lg xl:text-2xl"
              >
                {service.title}
              </h2>
              <p class="text-(--color-text-primary) text-base lg:text-sm">
                {service.description}
              </p>
            </section>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  #title-card-sticky {
    color:;
  }
  .btn-item-service {
    color: var(--color-text-primary);
    background-color: rgb(255 255 255 / 0.06);
  }
</style>
