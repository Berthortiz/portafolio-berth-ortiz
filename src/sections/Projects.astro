---
import { Icon } from "astro-icon/components";
import Picture from "astro/components/Picture.astro";
import fgcImg from "../assets/img/projects/fgcconsulting.png";
import mariaImg from "../assets/img/projects/web-maria-martell.jpg";
import k26Img from "../assets/img/projects/k26.png";

const projects = [
  {
    id: 1,
    name_proyect: "Consulting FGC",
    sub_title: "Landing Page Corporativa ",
    image: fgcImg,
    description:
      "Una consultora en Florida que facilita la integración y el crecimiento de los recién llegados a Estados Unidos. Ofrece servicios clave como asesoría en trámites migratorios, creación y registro de empresas con obtención de EIN, orientación financiera para mejorar el crédito e inversión, y la gestión efectiva para recuperar fondos excedentes de propiedades subastadas.",
    technologies: [
      {
        iconName: "icon_wordpress",
        label: "WordPress",
      },
      {
        iconName: "elementor",
        label: "Elementor",
      },
    ],
    buttons: [
      {
        name: "Ver Sitio Web",
        link: "https://consultingfgc.com/es_es/",
        icon: "icon-link",
      },
      {
        name: "Hacer Cotización",
        link: "https://wa.link/bqgy6d",
        icon: "whatsapp-solid",
      },
    ],
  },
  {
    id: 2,
    name_proyect: "Maria A. Martel",
    sub_title: "Landing Page Corporativa ",
    image: mariaImg,
    description:
      "Esta web presenta a María Alejandra Martell, Realtor® bilingüe en Florida (Miami, Orlando y Tampa). Ofrece servicios de compra, venta e inversión inmobiliaria para la comunidad latina. Su método de cinco pasos guía desde el análisis financiero hasta la entrega de llaves, complementado con planes de marketing personalizados y una guía gratuita para inversores.",
    technologies: [
      {
        iconName: "icon_wordpress",
        label: "WordPress",
      },
      {
        iconName: "elementor",
        label: "Elementor",
      },
    ],
    buttons: [
      {
        name: "Ver Sitio Web",
        link: "https://marialerealtor.com/",
        icon: "icon-link",
      },
      {
        name: "Hacer Cotización",
        link: "https://wa.link/bqgy6d",
        icon: "whatsapp-solid",
      },
    ],
  },

  {
    id: 3,
    name_proyect: "K26 Arquitectura",
    sub_title: "Portafolio web ",
    image: k26Img,
    description:
      "K26 es un estudio de arquitectura y construcción en Costa Rica que destaca por su modelo integrado Design-Build (Diseño y Construcción). Con más de una década de trayectoria, la firma liderada por Diego Núñez fusiona la creatividad visual con el rigor técnico estructural para crear residencias y espacios comerciales modernos, funcionales y de alta calidad.",
    technologies: [
      {
        iconName: "icon_wordpress",
        label: "WordPress",
      },
      {
        iconName: "elementor",
        label: "Elementor",
      },
    ],
    buttons: [
      {
        name: "Ver Sitio Web",
        link: "https://k26arquitectura.com/",
        icon: "icon-link",
      },
      {
        name: "Hacer Cotización",
        link: "https://wa.link/bqgy6d",
        icon: "whatsapp-solid",
      },
    ],
  },
];

