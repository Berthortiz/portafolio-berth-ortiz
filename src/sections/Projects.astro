---

<section id="proyects" class="w-full text-white">
  <!-- Contenido centrado (la atmósfera de profundidad es la capa global
       fija del layout, BRAND.md §6; esta sección no pinta fondo propio para
       que las luces ambientales de la marca se vean a través). -->
  <div
    class="mx-auto flex max-w-7xl flex-col justify-center px-6 py-18 lg:pt-16"
  >
  <p
    class="text-center text-1xl tracking-widest text-brand uppercase pt-2.5 pb-2 font-semibold self-center"
  >
    Portafolio
  </p>
  <h2
    class="text-3xl md:text-5xl font-bold text-center text-white mb-4 self-center"
  >
    Sitios web que he desarrollado
  </h2>
  <p
    class="md:w-[76ch] text-[1.2em] text-gray-400 pb-16 self-center text-center"
  >
    Echa un vistazo a cómo hé construido los sitios web de mis clientes:
    funcionales y listos para crecer.
  </p>

  <article class="grid-projects">
    {
      projects.map((item) => (
        <section class="flex flex-col pb-12 lg:w-full lg:gap-8 bg-zinc-500/5">
          <div class="w-full flex justify-center">
            <Picture
              src={item.image}
              alt={`Vista previa del proyecto ${item.name_proyect}`}
              formats={["webp"]}
              quality={80}
              loading="lazy"
              decoding="async"
              class="w-full object-contain rounded-2xl overflow-hidden h-fit"
            />
            {
              // galeria de imagenes slider en version movil, y pc
            }
          </div>

          <div class="w-full text-left flex flex-col justify-center gap-2 pt-1 lg:p-3">
            <h2 class="text-3xl font-bold text-gray-300 pt-4 lg:text-3xl">
              {item.name_proyect}
            </h2>
            <h3 class="font-bold">{item.sub_title}</h3>

            <p class="text-gray-400">{item.description}</p>

            <div class="flex flex-col-reverse gap-6 pt-3">
              {item.buttons.map((button) => (
                <a
                  href={button.link}
                  class="btn-project flex justify-center px-4 py-1.5 gap-2 rounded text-lg"
                >
                  <span class="flex items-center ">
                    {<Icon name={button.icon} size={20} class="" />}
                  </span>
                  {button.name}
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </article>
  </div>

  <style>
    .btn-project:first-child {
      background-color: var(--color-brand);
    }

    .btn-project:nth-child(2) {
      padding: 0;
      border-radius: 0;
      line-height: 2;
    }

    .btn-project:nth-child(2):hover {
      background: rgb(255 255 255 / 0.08);
    }

    .grid-projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 3em;

      & section {
        padding: 1.4em;
        border-radius: 14px;
        background-color: rgb(255 255 255 / 0.04);
      }
    }

    /* Celulares grandes / Tablets (sm: 640px) */
    @media (width >= 640px) {
      /* Tus estilos aquí */
    }

    /* Tablets en horizontal (md: 768px) */
    @media (width >= 768px) {
      /* Tus estilos aquí */
    }

    /* Laptops / Pantallas de escritorio (lg: 1024px) */
    @media (width >= 1024px) {
      /* Tus estilos aquí */
    }

    /* Escritorios grandes (xl: 1280px) */
    @media (width >= 1280px) {
      /* Tus estilos aquí */
    }

    /* Pantallas gigantes / Monitores (2xl: 1536px) */
    @media (width >= 1536px) {
      /* Tus estilos aquí */
    }
  </style>
</section>
