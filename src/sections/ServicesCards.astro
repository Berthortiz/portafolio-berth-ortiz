---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "../components/ButtonPrimary.astro";

// src/pages/servicios.astro
const services = [
    {
        icon: "web-icon",
        title: "Portafolio Web",
        description:
            "Creación de sitios web informativos y portafolios profesionales. Perfecto para mostrar tu trabajo.",
    },
    {
        icon: "code-icon",
        title: "Página web a medida",
        description:
            "Desarrollo exclusivo, priorizando la velocidad y mostras funciones específicas de tu negocio. Perfecto para Inmobiliarias, Academias Online, etc.",
    },
    {
        icon: "shop",
        title: "Tiendas Online",
        description:
            "Lleva tu negocio al siguiente nivel con una tienda virtual completa y pagos seguros.",
    },
];
---

<section class="relative overflow-hidden lg:py-24 px-4">
    <p
        class="text-center text-sm text-brand mb-2 font-semibold"
    >
        ¡Creamos la Páginas web que necesitas!
    </p>
    <h2 class="text-3xl md:text-5xl font-bold text-center text-white mb-4">
        Una página web que impulsa tu negocio
    </h2>
    <p
        class="text-center text-zinc-400 max-w-2xl mx-auto mb-16 text-sm md:text-base"
    >
        Ayuda a tus clientes a conocer tus servicios, descubrir qué hace único a
        tu negocio y contactarte fácilmente.
    </p>

    <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 px-6 lg:max-w-7xl mx-auto relative z-10"
    >
        {
            services.map((service) => (
                <div class="px-8 py-10 md:px-10 md:py-14 rounded-lg bg-zinc-500/5 flex flex-col items-center text-center gap-4 hover:bg-zinc-500/10 transition-colors duration-300 group">
                    <span class="text-6xl mb-2 group-hover:scale-110 transition-transform duration-300">
                        <Icon
                            name={
                                service.icon === "" ? "star" : `${service.icon}`
                            }
                            size={50}
                            class="text-(--color-brand-secundary) w-full h-auto"
                        />
                    </span>
                    <h3 class="text-xl font-semibold text-white">
                        {service.title}
                    </h3>
                    <p class="text-gray-400 text-[15px] leading-relaxed">
                        {service.description}
                    </p>
                    <ButtonPrimary
                        title="Contactar"
                        link="https://wa.link/bqgy6d"
                        additionalClass="px-4 py-2 text-white items-center"
                    >
                        {" "}
                        <Icon
                            name="whatsapp-solid"
                            slot="before-icon"
                            size={20}
                            class=""
                        />{" "}
                    </ButtonPrimary>
                </div>
            ))
        }
    </div>
</section>

<style>
</style>
</style>
