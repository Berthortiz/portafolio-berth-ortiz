---
interface Props {
    title: string;
    link: string;
    additionalClass?: string;
    bg?: string;
}

const {
    title,
    link,
    additionalClass = false,
    bg = "var(--color-brand)",
} = Astro.props;

const tieneColor = bg !== "transparent";
const estilo = tieneColor
    ? `background-image: linear-gradient(90deg, var(--color-brand), var(--color-brand-two), var(--color-brand)); background-size: 400%;` /* taste-skill-ignore: gradiente de marca, BRAND.md §2 */
    : `background-color:${bg} ;`;
---

<a
    style={estilo}
    class={`buttomPrimary w-fit flex gap-1.5 h-fit ${!additionalClass ? " px-2 py-2 " : additionalClass} ${tieneColor ? "glow" : ""}`}
    class:list={{}}
    href={link}
    rel="noopener noreferrer"
    aria-label={`Contactar por WhatsApp`}
>
    <slot name="before-icon" />
    {title}
</a>

<style>
    .buttomPrimary {
        border-radius: 4px;
    }

    .glow {
        position: relative;
        z-index: 1;
        user-select: none;
        cursor: pointer;
        border: none;
    }

    .glow::before {
        content: "";
        position: absolute;
        top: -5px;
        right: -5px;
        bottom: -5px;
        left: -5px;
        z-index: -1;
        background: linear-gradient(90deg, var(--color-brand), var(--color-brand-two), var(--color-brand)); /* taste-skill-ignore: gradiente de marca, BRAND.md §2 */
        background-size: 400%;
        border-radius: 9px;
        opacity: 0;
        transition: 0.5s;
    }

    .glow:hover {
        animation: flujo-btn 8s linear infinite;
    }

    .glow:hover::before {
        filter: blur(20px);
        opacity: 1;
        animation: flujo-btn 8s linear infinite;
    }

    @keyframes flujo-btn {
        0% {
            background-position: 0%;
        }
        100% {
            background-position: 400%;
        }
    }
</style>
