---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "./ButtonPrimary.astro";
import bgHeroImg from "/public/images/raep-background-hero.png";
import Picture from "astro/components/Picture.astro";

---

<section class="hero w-full md:items-center flex flex-col justify-between relative text-gray-600 body-font">
    <!-- Fondo con imagen y overlay -->
    <!-- <div class="absolute left-0 right-0">
        <img src={bgHeroImg.src} alt="Fondo hero" class="w-full" />
        </div> -->

    <!-- <div id="overlay" class="absolute inset-0 indent-5"></div> -->

    <!-- t -->
    <div
        class="flex lg:max-w-7xl mx-auto md:px-14 pt-1 md:pt-14 items-center justify-center relative z-10"
    >
        <div
            class="md:w-4/5 flex md:pt-1 flex-col justify-center items-center md:text-left mb-0 md:mb-0 p-6"
        >
          

            <h1
                class="title-font
                leading-10 md:leading-10
            
                font-bold
                text-center
                text-4xl sm:text-4xl md:text-4xl lg:text-4xl
                mb-4
                text-gray-100"
            >
                Creamos la 
                <span class="gradiente-title-hero"> Página Web

 </span>  de tu negocio para que empiece a vender hoy
            </h1>
            <p class="mb-8 leading-relaxed text-gray-200 md:text-[1em] lg:w-[70ch] text-center">
              "Diseñamos sitios web modernos y estratégicos que convierten visitantes en clientes. Con tecnología actual, copy persuasivo y un enfoque en resultados, tu negocio tendrá la presencia digital que necesita para crecer desde el primer día."
            </p>
            <div class="w-full flex flex-col md:flex-row justify-center gap-4 lg:items-center border-amber-50 ">
           

  <ButtonPrimary  title="Cotizar Mi Web"
                    link="https://wa.link/bqgy6d"
                    additionalClass="w-full md:w-fit px-4 py-2 text-white justify-center items-center text-[1.2em] border-2 border-[color:var(--color-brand)]"
                > <Icon name="whatsapp-solid" slot="before-icon" size={20} class="" /> </ButtonPrimary>
                

 <ButtonPrimary
                    title="Ver Portafolio"
                    class:list=""
                    link="#proyects"
                    additionalClass="w-full md:w-fit items-center justify-center text-[1.2em] px-5 py-2 border-2 border-[color:var(--color-text-primary)] text-(--color-text-primary) hover:border-[color:var(--color-brand-secundary)] hover:text-(--color-brand-secundary)"
                    bg="transparent"
                /> 
                
            </div>
        </div>
       
    </div>



</section>

<style>

#arrow-down-id::before {
    
    content: "Ver Portafolio";
    text-align: center;
    color:rgb(200, 200, 200);
    position: absolute;
    z-index: 3;
    width: 200px;
    /* height: 30px; */
    /* background-color: red; */
    transform: translateX( calc(-50% + 20px  ) );
    top: 0px;
    left: 0;


    }
    #arrow-down-id {
        margin-top: 30px;
        position:relative;
    }

    #overlay {
        backdrop-filter: blur(5px);
        padding: 20px;
        border-radius: 8px;
    }

    #logo-bg {
        opacity: 0.7;
        position: relative;
        /* border: 1px solid red; */
        padding: 40px;
    }

    #container-logo-bg::before {
        content: "";
        /* border: 1px solid red; */

        backdrop-filter: blur(5px);

        color: aqua;
        position: absolute;
        z-index: 10;
    }

    .hero {
        --bg-transparent: 0.78;
        background-image:
            linear-gradient(
                rgba(0, 0, 0, var(--bg-transparent)),
                rgba(0, 0, 0, var(--bg-transparent))
            )
        background-size: cover;
        background-position: center;
        height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: black;
    }

    .gradiente-title-hero {
        --color-gradient: #03cff3;
        background-image: linear-gradient(
            to right,
            var(--color-brand),
            var(--color-gradient)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

  
</style>
