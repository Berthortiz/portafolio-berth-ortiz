---
import ButtonPrimary from "./ButtonPrimary.astro";
import bgHeroImg from "/public/images/raep-background-hero.png";
import Picture from "astro/components/Picture.astro";
---

<section class="hero w-full md:items-center relative text-gray-600 body-font">
    <!-- Fondo con imagen y overlay -->
    <!-- <div class="absolute left-0 right-0">
        <img src={bgHeroImg.src} alt="Fondo hero" class="w-full" />
        </div> -->

    <div id="overlay" class="absolute inset-0 indent-5"></div>

    <!-- t -->
    <div
        class="flex lg:max-w-7xl mx-auto px-4 md:px-14 py-14 items-center justify-center relative z-10"
    >
        <div
            class="md:w-4/5 flex flex-col justify-center items-center md:text-left mb-16 md:mb-0"
        >
          

            <h1
                class="title-font
                leading-10 lg:leading-10
            
                font-bold
                text-center
                text-3xl sm:text-4xl md:text-4xl lg:text-4xl
                mb-4
                text-gray-100"
            >
                Creamos la 
                <span class="gradiente-title-hero"> Página Web

 </span>  de tu negocio para que empiece a vender hoy
            </h1>
            <p class="mb-8 leading-relaxed text-gray-200 md:text-[1em] w-[70ch] text-center">
              "Diseñamos sitios web modernos y estratégicos que convierten visitantes en clientes. Con tecnología actual, copy persuasivo y un enfoque en resultados, tu negocio tendrá la presencia digital que necesita para crecer desde el primer día."
            </p>
            <div class="flex justify-center gap-3 lg:items-center">
                <ButtonPrimary
                    title="Solicitar presupuesto"
                    link="#"
                    additionalClass="px-5  py-2 text-white"
                />
 <ButtonPrimary
                    title="Ver Portafolio"
                    class:list="text-gray-900"
                    link="#"
                    additionalClass="px-5 py-2 text-gray-600"
                    bg="white"
                />
               
            </div>
        </div>
       
    </div>
</section>

<style>
    #overlay {
        backdrop-filter: blur(5px);
        padding: 20px;
        border-radius: 8px;
    }

    #logo-bg {
        opacity: 0.7;
        position: relative;
        /* border: 1px solid red; */
        padding: 40px;
    }

    #container-logo-bg::before {
        content: "";
        /* border: 1px solid red; */

        backdrop-filter: blur(5px);

        color: aqua;
        position: absolute;
        z-index: 10;
    }

    .hero {
        --bg-transparent: 0.78;
        background-image:
            linear-gradient(
                rgba(0, 0, 0, var(--bg-transparent)),
                rgba(0, 0, 0, var(--bg-transparent))
            )
        background-size: cover;
        background-position: center;
        height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: black;
    }

    .gradiente-title-hero {
        --color-gradient: #03cff3;
        background-image: linear-gradient(
            to right,
            var(--color-brand),
            var(--color-gradient)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

  
</style>
